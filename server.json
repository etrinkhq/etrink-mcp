{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.etrinkhq/etrink",
  "title": "etrink",
  "description": "Hosted MetaTrader 5 terminals and service hosting: read MT5 accounts, positions, reports; deploy bots.",
  "repository": { "url": "https://github.com/etrinkhq/etrink-mcp", "source": "github" },
  "websiteUrl": "https://etrink.com/mcp",
  "version": "0.3.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "etrink-mcp",
      "version": "0.3.1",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        { "name": "ETRINK_API_KEY", "description": "etrink API key (panel → API keys)", "isRequired": true, "isSecret": true, "format": "string" }
      ]
    }
  ]
}
